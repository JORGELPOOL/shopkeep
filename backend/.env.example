PORT=3000
APP_KEY=change-me                 # same value as appKey in the Flutter app
PUBLIC_URL=https://api.example.com
# MTN MoMo Collection (sandbox values shown; production uses your live keys, GHS and base https://proxy.momoapi.mtn.com)
MTN_BASE=https://sandbox.momodeveloper.mtn.com
MTN_ENV=sandbox
MTN_CURRENCY=EUR
MTN_SUB_KEY=
MTN_API_USER=
MTN_API_KEY=
# SMS (Arkesel) and WhatsApp (Meta Cloud API). Leave blank to skip a channel.
SMS_SENDER=ShopKeep
ARKESEL_KEY=
WA_PHONE_ID=
WA_TOKEN=
ALLOW_ORIGIN=*                  # production: your app's address, e.g. https://app.example.com
